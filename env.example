# Copy to .env.local in the project root.
# Required: server-side only (never use NEXT_PUBLIC_ for this)
OPENAI_API_KEY=sk-...

# Optional: defaults to gpt-4.1-mini (structured outputs, document analysis).
# OpenAI also documents newer models (e.g. gpt-6.1-sol) when available on your account.
# OPENAI_MODEL=gpt-4.1-mini
